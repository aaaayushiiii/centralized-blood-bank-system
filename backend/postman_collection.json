    {
      "name": "2. Nearby Hospitals (Geolocation)",
      "item": [
        {
          "name": "Nearby Hospitals by Pincode (560001 - MG Road)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/hospitals/nearby?pincode=560001&radius=30",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "hospitals", "nearby"],
              "query": [
                { "key": "pincode", "value": "560001" },
                { "key": "radius", "value": "30" }
              ]
