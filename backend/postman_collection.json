    {
      "name": "4. Emergency Request (4-Table FEFO Transaction)",
      "item": [
        {
          "name": "Post Emergency Blood Demand (2 Units O+)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hospital_id\": \"HOSP-01\",\n  \"blood_group\": \"O\",\n  \"rh_factor\": \"+\",\n  \"units_requested\": 2,\n  \"priority\": \"CRITICAL\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/requests/emergency",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "requests", "emergency"]
            }
          }
        },
