{
  "info": {
    "name": "Java JDBC Blood Bank API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Real Oracle operations. Session first, login, then protected requests. Dispatch commits actual stock reservations. Supply credentials locally; no demo passwords."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080/api"
    },
    {
      "key": "csrf_token",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "role",
      "value": "HOSPITAL_STAFF"
    },
    {
      "key": "hospital_id",
      "value": ""
    },
    {
      "key": "request_id",
      "value": ""
    },
    {
      "key": "pincode",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health (actual JDBC)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "2. Guest session / CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.csrf_token) pm.collectionVariables.set(\"csrf_token\", data.csrf_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Hospitals",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/hospitals"
      }
    },
    {
      "name": "Register citizen",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{baseUrl}}/auth/register/citizen",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"full_name\": \"New citizen\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Request staff access (pending approval)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{baseUrl}}/auth/register/hospital",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"full_name\": \"New staff\",\n  \"hospital_id\": \"{{hospital_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "3. Login (refreshes CSRF)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"{{role}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.csrf_token) pm.collectionVariables.set(\"csrf_token\", data.csrf_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Confirm session",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.csrf_token) pm.collectionVariables.set(\"csrf_token\", data.csrf_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Search compatible stock",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/hospitals/nearby?pincode={{pincode}}&blood_group=O&rh_factor=%2B"
      }
    },
    {
      "name": "Assigned inventory",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/hospitals/{{hospital_id}}/inventory"
      }
    },
    {
      "name": "Create pending request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{baseUrl}}/requests",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hospital_id\": \"{{hospital_id}}\",\n  \"blood_group\": \"O\",\n  \"rh_factor\": \"+\",\n  \"units_requested\": 1,\n  \"priority\": \"Critical\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set(\"request_id\", pm.response.json().request.request_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Dispatch existing request (commits real changes)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{baseUrl}}/requests/{{request_id}}/allocations",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Read existing allocations",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/requests/{{request_id}}/allocations"
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{baseUrl}}/auth/logout",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
