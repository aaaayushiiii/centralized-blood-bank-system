# All public and authenticated screens use the Java REST API.
VITE_API_MODE=live
# Includes /api; auth paths are appended once, e.g. /api/auth/login.
VITE_API_BASE_URL=http://127.0.0.1:8080/api
# Local development only; always disabled by Vite build and production preview.
VITE_ENABLE_PREVIEW=false
